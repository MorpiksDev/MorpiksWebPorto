# Copy to .env.local and fill in.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Sender. Use the sandbox sender until morpiks.com DNS is verified in Resend:
#   CONTACT_FROM="Morpiks Website <onboarding@resend.dev>"
# Note: the sandbox sender can only deliver to the email that owns the Resend account.
# After verification:
#   CONTACT_FROM="Morpiks Website <no-reply@morpiks.com>"
CONTACT_FROM="Morpiks Website <onboarding@resend.dev>"

# Recipient (defaults to info@morpiks.com)
CONTACT_TO=info@morpiks.com
